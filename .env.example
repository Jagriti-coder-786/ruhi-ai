# ==========================================
# 🌸 RUHI AI - ENVIRONMENT CONFIGURATION
# ==========================================

# Core Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=ruhi_ai_super_secret_jwt_key_2026_replace_in_production

# Database (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/ruhi_ai

# Primary AI Provider (Google Gemini API)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=

# Optional AI Providers (Architecturally Supported)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Payments & Subscriptions (Razorpay - India)
# Get test keys from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional Web Search Provider
TAVILY_API_KEY=
